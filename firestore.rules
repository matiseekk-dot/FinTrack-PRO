rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // User data - tylko właściciel może czytać/pisać swoje dane
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Sub-kolekcje (transactions, accounts, etc.) - dziedziczą
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Licencje PRO usunięte w 2.6.0 (aplikacja jest darmowa) — kolekcja /licenses nie jest już
    // zapisywalna; stare dokumenty zostają nietknięte.

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
